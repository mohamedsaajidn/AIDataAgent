# Postgres
POSTGRES_USER=dataagent
POSTGRES_PASSWORD=dataagent_dev_password
POSTGRES_DB=dataagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage) - swap S3_ENDPOINT_URL to a real AWS
# endpoint (and drop it entirely to use AWS's default resolver) to move to the cloud.
# Host ports are remapped to 9002/9003 (9000/9001 were already taken locally by
# Zscaler on this machine) - containers still talk to each other on 9000/9001.
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dataagent-datasets
S3_REGION=us-east-1

# Redis
REDIS_URL=redis://localhost:6379/0

# Chroma (mapped to host port 8001 to avoid clashing with the API's 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM provider switch - "openrouter" (default), "gemini" (Google AI Studio,
# API-key auth), or "vertex" (Google Cloud Vertex AI, project+ADC auth - a
# different auth model from "gemini" despite serving the same models). See
# the "LLM provider" section in CLAUDE.md. Swapping this is a one-line
# change; no code needs to change either way.
LLM_PROVIDER=openrouter

# OpenRouter - get a key at https://openrouter.ai/keys
# Check https://openrouter.ai/models?max_price=0 for the current list of free models;
# the default below may have been retired by the time you read this.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
# Caps the requested max_tokens - without this OpenRouter checks account
# affordability against the model's full context window, so a low balance
# fails every request outright (even a tiny one) instead of just large ones.
OPENROUTER_MAX_TOKENS=4096

# Gemini (Google AI Studio) - only used when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=4096

# Vertex AI (Google Cloud) - only used when LLM_PROVIDER=vertex. Requires a
# GCP project with Vertex AI enabled and billing set up - this is a paid
# product, not AI Studio's free tier. VERTEX_PROJECT is the project ID (the
# short string, e.g. "my-app-123"), never the numeric project number.
# Auth - set exactly ONE of these three, in order of simplicity:
#   1. VERTEX_API_KEY - a Vertex-AI-enabled API key from the GCP Console
#      (NOT the same kind of key as GEMINI_API_KEY above). Simplest option,
#      no gcloud CLI or service account needed.
#   2. VERTEX_CREDENTIALS_PATH - a downloaded service account JSON key
#      (grant it the "Vertex AI User" role in the GCP Console first).
#   3. Leave both empty to fall back to Application Default Credentials -
#      requires the gcloud CLI: run `gcloud auth application-default
#      login` once.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_MAX_TOKENS=4096
VERTEX_API_KEY=
VERTEX_CREDENTIALS_PATH=

# Observability (Arize Phoenix, self-hosted single container via
# docker-compose - see CLAUDE.md's "Guardrails" section for why Phoenix
# over Langfuse). Off by default so a Phoenix-less dev setup doesn't fail
# trying to export spans nowhere - flip on once `docker compose up`
# includes the phoenix service. UI/dashboard at http://localhost:6006.
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=aidataagent
