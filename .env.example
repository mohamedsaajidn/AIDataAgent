# Postgres
POSTGRES_USER=dataagent
POSTGRES_PASSWORD=dataagent_dev_password
POSTGRES_DB=dataagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage) - swap S3_ENDPOINT_URL to a real AWS
# endpoint (and drop it entirely to use AWS's default resolver) to move to the cloud.
# Host ports are remapped to 9002/9003 (9000/9001 were already taken locally by
# Zscaler on this machine) - containers still talk to each other on 9000/9001.
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dataagent-datasets
S3_REGION=us-east-1

# Redis
REDIS_URL=redis://localhost:6379/0

# Chroma (mapped to host port 8001 to avoid clashing with the API's 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM provider switch - "openrouter" (default) or "gemini". See the "LLM
# provider" section in CLAUDE.md. Swapping this is a one-line change; no code
# needs to change either way.
LLM_PROVIDER=openrouter

# OpenRouter - get a key at https://openrouter.ai/keys
# Check https://openrouter.ai/models?max_price=0 for the current list of free models;
# the default below may have been retired by the time you read this.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Gemini (Google AI Studio) - only used when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
